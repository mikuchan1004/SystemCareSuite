<Window x:Class="SystemCareSuite.RamExclusionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RAM 부스트 제외 프로그램 (화이트리스트) 설정"
        Width="820" Height="580"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="RAM 부스트 제외 프로그램 (화이트리스트)" FontSize="18" FontWeight="ExtraBold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="원클릭 RAM 부스트 실행 시 메모리(워킹셋)를 비우지 않고 온전히 유지할 프로세스를 지정합니다." FontSize="12.5" Foreground="#8B949E" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Direct Input Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="직접 추가:" FontSize="13" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="TxtCustomProcessName"
                         Background="#0B0F17" Foreground="#F0F6FC" BorderBrush="#30405A" BorderThickness="1"
                         Padding="8,5" FontSize="13" VerticalContentAlignment="Center"
                         ToolTip="예: game, obs64, devenv, chrome (.exe 제외 또는 포함 가능)"/>
                <TextBlock Grid.Column="2" Text="별칭(선택):" FontSize="13" Foreground="#8B949E" VerticalAlignment="Center" Margin="10,0,8,0"/>
                <TextBox Grid.Column="3" x:Name="TxtCustomDisplayName"
                         Background="#0B0F17" Foreground="#F0F6FC" BorderBrush="#30405A" BorderThickness="1"
                         Padding="8,5" FontSize="13" VerticalContentAlignment="Center"
                         ToolTip="예: 고사양 게임, 방송 프로그램 등"/>
                <Button Grid.Column="4" Content="➕ 등록" Style="{StaticResource NeonActionButton}" Padding="14,6" FontSize="12" Margin="10,0,0,0" Click="BtnAddCustom_Click"/>
            </Grid>
        </Border>

        <!-- 2 Columns: Running Processes (Left) vs Excluded List (Right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Running Processes -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚡ 현재 실행 중인 프로세스" FontSize="13.5" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🔄 갱신" Style="{StaticResource OutlineActionButton}" Padding="8,3" FontSize="11" Click="BtnRefreshRunning_Click"/>
                    </Grid>

                    <!-- Filter Box -->
                    <TextBox Grid.Row="1" x:Name="TxtSearchRunning"
                             Background="#0B0F17" Foreground="#F0F6FC" BorderBrush="#30405A" BorderThickness="1"
                             Padding="8,4" FontSize="12.5" Margin="0,0,0,8"
                             TextChanged="TxtSearchRunning_TextChanged"/>

                    <ListBox Grid.Row="2" x:Name="LbRunningProcesses"
                             Background="#880E1420" BorderBrush="#25354D" BorderThickness="1"
                             Foreground="#F0F6FC" FontSize="13"
                             MouseDoubleClick="LbRunningProcesses_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding}" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="+ 추가" FontSize="11" Foreground="#00E5A3" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Configured Exclusions -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🛡️ 부스트 제외 목록" FontSize="13.5" FontWeight="Bold" Foreground="#00E5A3" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="모두 활성화" Style="{StaticResource OutlineActionButton}" Padding="8,3" FontSize="11" Margin="0,0,4,0" Click="BtnEnableAll_Click"/>
                            <Button Content="모두 해제" Style="{StaticResource OutlineActionButton}" Padding="8,3" FontSize="11" Click="BtnDisableAll_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Excluded Items ListView -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IcExcludedItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#990E1420" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="제외 활성 여부 토글"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProcessName}" FontSize="13" FontWeight="Bold" Foreground="#00F0FF"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11.5" Foreground="#8B949E" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="❌ 삭제" Style="{StaticResource OutlineActionButton}"
                                                    Foreground="#FF4D6D" BorderBrush="#44FF4D6D" Padding="8,4" FontSize="11"
                                                    Click="BtnRemoveExclusion_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" x:Name="TxtExclusionSummary" Text="등록된 제외 프로그램: 0개" FontSize="12" Foreground="#8B949E" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="💡 팁: 왼쪽 프로세스를 더블 클릭하면 제외 목록에 즉시 추가됩니다." FontSize="12" Foreground="#6E7681" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="💾 저장 후 닫기" Style="{StaticResource NeonActionButton}" Padding="20,8" FontSize="13" Click="BtnSaveAndClose_Click"/>
        </Grid>
    </Grid>
</Window>
