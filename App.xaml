<Application x:Class="SystemCareSuite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Modern Dark Neon Palette (Semi-transparent Glassmorphic for Miku_Jirai Background) -->
        <SolidColorBrush x:Key="BgDeepBrush" Color="#0B0F17"/>
        <SolidColorBrush x:Key="BgSidebarBrush" Color="#B80D121C"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#B5131B2A"/>
        <SolidColorBrush x:Key="BgCardHoverBrush" Color="#CC1C263B"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="NeonCyanBrush" Color="#00F0FF"/>
        <SolidColorBrush x:Key="NeonMintBrush" Color="#00E5A3"/>
        <SolidColorBrush x:Key="NeonAmberBrush" Color="#FFB800"/>
        <SolidColorBrush x:Key="NeonCrimsonBrush" Color="#FF4D6D"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F6FC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E"/>

        <!-- Global TextBlock Overhang Protection (Prevents Emoji & Bold Korean Glyph Clipping) -->
        <Style TargetType="TextBlock">
            <Setter Property="Padding" Value="1,1,3,1"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <!-- Sidebar Navigation RadioButton Style -->
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="12,0,10,0">
                            <Grid>
                                <Border x:Name="ActiveBar"
                                        Width="4"
                                        Height="24"
                                        CornerRadius="2"
                                        Background="{StaticResource NeonCyanBrush}"
                                        HorizontalAlignment="Left"
                                        Margin="-12,0,0,0"
                                        Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#1A2333"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#1B2A40"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Neon Button -->
        <Style x:Key="NeonActionButton" TargetType="Button">
            <Setter Property="Background" Value="#00F0FF"/>
            <Setter Property="Foreground" Value="#0B0F17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#263248"/>
                                <Setter Property="Foreground" Value="#586574"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outline Button -->
        <Style x:Key="OutlineActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1A2333"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30405A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#243147"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
    </Application.Resources>
</Application>
